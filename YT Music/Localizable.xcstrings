        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn down tracks that are louder than YouTube's reference level, as YouTube does."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisser le volume des titres plus forts que le niveau de référence de YouTube, comme le fait YouTube."
          }
        }
      }
    },
    "settings.playback.prefer_audio": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer audio over video"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférer l’audio à la vidéo"
          }
        }
      }
    },
    "settings.playback.prefer_audio.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play music videos as audio-only streams. Turn off to allow combined video+audio streams when they're higher quality."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire les clips musicaux en flux audio seul. Désactivez pour autoriser les flux vidéo et audio combinés quand leur qualité est supérieure."
          }
        }
      }
    },
    "settings.playback.preload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preload next track"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précharger le titre suivant"
          }
        }
      }
    },
    "settings.playback.preload.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start buffering the next track before the current one ends. This can reduce gaps on a slow connection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer à mettre en mémoire tampon le titre suivant avant la fin du titre en cours. Cela peut réduire les coupures sur une connexion lente."
          }
        }
      }
    },
    "settings.playback.preload.off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé"
          }
        }
      }
    },
